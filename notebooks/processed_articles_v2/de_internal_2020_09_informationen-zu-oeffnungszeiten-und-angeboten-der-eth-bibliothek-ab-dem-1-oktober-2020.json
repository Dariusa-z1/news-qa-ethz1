{
  "filename": "de_internal_2020_09_informationen-zu-oeffnungszeiten-und-angeboten-der-eth-bibliothek-ab-dem-1-oktober-2020.md",
  "original_filename": "de_internal_2020_09_informationen-zu-oeffnungszeiten-und-angeboten-der-eth-bibliothek-ab-dem-1-oktober-2020.html",
