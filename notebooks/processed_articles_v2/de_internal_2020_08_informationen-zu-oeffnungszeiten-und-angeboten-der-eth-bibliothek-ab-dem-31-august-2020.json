  "filename": "de_internal_2020_08_informationen-zu-oeffnungszeiten-und-angeboten-der-eth-bibliothek-ab-dem-31-august-2020.md",
  "original_filename": "de_internal_2020_08_informationen-zu-oeffnungszeiten-und-angeboten-der-eth-bibliothek-ab-dem-31-august-2020.html",
