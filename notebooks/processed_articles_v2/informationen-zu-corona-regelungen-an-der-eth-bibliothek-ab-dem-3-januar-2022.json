  "filename": "informationen-zu-corona-regelungen-an-der-eth-bibliothek-ab-dem-3-januar-2022.md",
  "original_filename": "informationen-zu-corona-regelungen-an-der-eth-bibliothek-ab-dem-3-januar-2022.html",
